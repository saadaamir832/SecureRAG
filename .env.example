# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: OpenAI API key for LLM generation (future enhancement)
# This would be used in an edge function, never exposed to the client
# OPENAI_API_KEY=your-openai-api-key

# Optional: JWT secret for custom token signing (if needed)
# JWT_SECRET=your-jwt-secret
